#!/usr/bin/env python3
"""A stand-in for util-linux's setsid(1), for machines without it (macOS): run the
command in a new session, forking first only if we are a process group leader."""
import os
import sys

if os.getpgrp() == os.getpid():
    if os.fork():
        os._exit(0)
os.setsid()
os.execvp(sys.argv[1], sys.argv[1:])
